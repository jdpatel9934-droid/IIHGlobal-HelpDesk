NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/support-ticket-tracker
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
FRONTEND_ORIGINS=http://localhost:5173

# Required by `npm run seed`; use unique, strong passwords for each account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_AGENT_EMAIL=agent@example.com
SEED_AGENT_PASSWORD=replace-with-a-strong-agent-password
SEED_EMPLOYEE_ONE_EMAIL=employee1@example.com
SEED_EMPLOYEE_ONE_PASSWORD=replace-with-a-strong-employee-password
SEED_EMPLOYEE_TWO_EMAIL=employee2@example.com
SEED_EMPLOYEE_TWO_PASSWORD=replace-with-another-strong-employee-password
